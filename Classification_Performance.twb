    <worksheet name='Portfolio bias %'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Total Revenue Bias (%)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'>If we add up all the model&apos;s predictions for every single user, how close is the grand total to the actual total amount of revenue made?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='analytics_data_may_whole' name='federated.0l6mh6l0pb0j3j1cyf9ex1y8h7ed' />
          </datasources>
          <datasource-dependencies datasource='federated.0l6mh6l0pb0j3j1cyf9ex1y8h7ed'>
            <column caption='Total Portfolio Bias (%)' datatype='real' name='[Calculation_0630435838873623]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([prediction]) - SUM([total_revenue_180d])) / SUM([total_revenue_180d])' />
            </column>
