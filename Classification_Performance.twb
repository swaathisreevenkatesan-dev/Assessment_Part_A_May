    <worksheet name='Recall'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Benton Sans Book' fontsize='8'>Recall</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'>Out of # users who were truly Active, what % did model predict correctly?</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='analytics_data_may_whole' name='federated.0l6mh6l0pb0j3j1cyf9ex1y8h7ed' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Threshold Parameter' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='33'>
              <calculation class='tableau' formula='33' />
              <range granularity='1' max='100' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0l6mh6l0pb0j3j1cyf9ex1y8h7ed'>
            <column caption='True Positive' datatype='integer' name='[Calculation_0630435794280448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [class_pred]&gt;=[Parameters].[Parameter 1] &#10;and [stayed_active_180d]=1 &#10;then 1 else 0 end' />
            </column>
            <column caption='False Negative' datatype='integer' name='[Calculation_0630435796893698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [class_pred]&lt;[Parameters].[Parameter 1] &#10;and [stayed_active_180d]=1&#10;then 1 else 0 end' />
            </column>
            <column caption='Recall' datatype='real' name='[Calculation_0630435800084485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_0630435794280448])/sum([Calculation_0630435794280448]+[Calculation_0630435796893698])' />
