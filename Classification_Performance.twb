    <worksheet name='Isolated Regression MAE'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Stage 2 Pure Conditional Error (Isolated Regression MAE)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'>When Stage 1 correctly guesses that a user is an active user, how accurate is Stage 2 on its own at guessing their exact revenue value?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='analytics_data_may_whole' name='federated.0l6mh6l0pb0j3j1cyf9ex1y8h7ed' />
          </datasources>
          <datasource-dependencies datasource='federated.0l6mh6l0pb0j3j1cyf9ex1y8h7ed'>
            <column caption='Stage 2 Pure Conditional Error (Isolated Regression MAE)' datatype='real' name='[Calculation_0630435839746074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [stayed_active_180d] = 1 THEN ABS([reg_pred] - [total_revenue_180d]) END)' />
            </column>
            <column caption='Acquisition Channel' datatype='string' name='[acquisition_channel]' role='dimension' type='nominal' />
            <column caption='Fs Date' datatype='date' name='[fs_date]' role='dimension' type='ordinal' />
