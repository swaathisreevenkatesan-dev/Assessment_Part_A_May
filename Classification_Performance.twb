            <column caption='Cell Actual Active' datatype='integer' name='[Calculation_0630435818143755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [stayed_active_180d] = 1 THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Cell Actual Inactive' datatype='integer' name='[Calculation_0630435818246156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [stayed_active_180d] = 0 THEN 1 ELSE 0 END)' />
            </column>
            <column caption='True Positive Rate' datatype='real' name='[Calculation_0630435828813844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM([Calculation_0630435818143755], 0, LAST()) / WINDOW_SUM([Calculation_0630435818143755], FIRST(), LAST())'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='False Positive Rate' datatype='real' name='[Calculation_0630435828875285]' role='measure' type='quantitative'>
