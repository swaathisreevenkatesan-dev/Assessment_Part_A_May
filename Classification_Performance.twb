    <worksheet name='RMSE'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Root Mean Squared Error (RMSE)</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'>This is the &quot;Huge Mistake Penalty&quot; metric. It calculates individual errors just like MAE, but it severely amplifies and punishes large errors.</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='analytics_data_may_whole' name='federated.0l6mh6l0pb0j3j1cyf9ex1y8h7ed' />
          </datasources>
          <datasource-dependencies datasource='federated.0l6mh6l0pb0j3j1cyf9ex1y8h7ed'>
            <column caption='Root Mean Squared Error (RMSE)' datatype='real' name='[Calculation_0630435839520793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SQRT(AVG(SQUARE([prediction] - [total_revenue_180d])))' />
