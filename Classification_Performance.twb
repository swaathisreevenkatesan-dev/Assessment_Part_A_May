    <worksheet name='Precision'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Benton Sans Book' fontsize='8'>Precision</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'>When a model predicts a user is Active, how often is it actually right?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='analytics_data_may_whole' name='federated.0l6mh6l0pb0j3j1cyf9ex1y8h7ed' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Threshold Parameter' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='33'>
              <calculation class='tableau' formula='33' />
              <range granularity='1' max='100' min='1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0l6mh6l0pb0j3j1cyf9ex1y8h7ed'>
            <column caption='True Positive' datatype='integer' name='[Calculation_0630435794280448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [class_pred]&gt;=[Parameters].[Parameter 1] &#10;and [stayed_active_180d]=1 &#10;then 1 else 0 end' />
            </column>
            <column caption='False Positive' datatype='integer' name='[Calculation_0630435796992003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [class_pred]&gt;=[Parameters].[Parameter 1] &#10;and [stayed_active_180d]=0&#10;then 1 else 0 end' />
            </column>
            <column caption='Precision' datatype='real' name='[Calculation_0630435800461318]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_0630435794280448])/sum([Calculation_0630435794280448] + [Calculation_0630435796992003])' />
            </column>
            <column caption='Acquisition Channel' datatype='string' name='[acquisition_channel]' role='dimension' type='nominal' />
            <column caption='Class Pred' datatype='integer' name='[class_pred]' role='measure' type='quantitative' />
