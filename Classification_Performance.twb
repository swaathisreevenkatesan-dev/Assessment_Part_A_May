      </column>
      <column caption='Accuracy' datatype='real' name='[Calculation_0630435814998026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_0630435794280448]+[Calculation_0630435796643841])&#10;/sum([Calculation_0630435794280448]+[Calculation_0630435796643841]+[Calculation_0630435796992003]+[Calculation_0630435796893698])' />
      </column>
