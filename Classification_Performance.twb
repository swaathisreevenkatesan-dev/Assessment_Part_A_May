            <column-instance column='[userage]' derivation='None' name='[none:userage:qk]' pivot='key' type='quantitative' />
            <column caption='Reg Pred' datatype='integer' name='[reg_pred]' role='measure' type='quantitative' />
            <column caption='Stayed Active 180D' datatype='integer' name='[stayed_active_180d]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Tier' datatype='integer' name='[tier]' role='dimension' type='ordinal' />
            <column caption='Total Revenue 180D' datatype='integer' name='[total_revenue_180d]' role='measure' type='quantitative' />
            <column caption='User Type' datatype='integer' name='[user_type]' role='measure' type='quantitative' />
            <column caption='Userage' datatype='integer' name='[userage]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0630435839746074]' derivation='User' name='[usr:Calculation_0630435839746074:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
