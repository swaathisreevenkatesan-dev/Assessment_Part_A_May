      </column>
      <column caption='F1 score' datatype='real' name='[Calculation_0630435800748039]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='2 * ([Calculation_0630435800461318] * [Calculation_0630435800084485]) / ([Calculation_0630435800461318] + [Calculation_0630435800084485])' />
      </column>
      <column caption='Active Rate - Predicted' datatype='real' name='[Calculation_0630435803025416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(IF [class_pred]&gt;=[Parameters].[Parameter 1] then 1 else 0 end)/ COUNTD([user_id])' />
      </column>
      <column caption='Active Rate - Actual' datatype='real' name='[Calculation_0630435803295753]' role='measure' type='quantitative'>
