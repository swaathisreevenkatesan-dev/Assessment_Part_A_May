    <worksheet name='Precision-Recall Tradeoff Curve'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Benton Sans Book' fontsize='8'>Precision-Recall Tradeoff Curve</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'>It shows the balancing act between being 100% correct versus predicting everyone, helping us find the sweet spot</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='analytics_data_may_whole' name='federated.0l6mh6l0pb0j3j1cyf9ex1y8h7ed' />
          </datasources>
          <datasource-dependencies datasource='federated.0l6mh6l0pb0j3j1cyf9ex1y8h7ed'>
            <column caption='Cell Actual Active' datatype='integer' name='[Calculation_0630435818143755]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [stayed_active_180d] = 1 THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Cell Actual Inactive' datatype='integer' name='[Calculation_0630435818246156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [stayed_active_180d] = 0 THEN 1 ELSE 0 END)' />
            </column>
            <column caption='True Positives (Curve)' datatype='integer' name='[Calculation_0630435818311693]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM([Calculation_0630435818143755], 0, LAST())'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='False Positives (Curve)' datatype='integer' name='[Calculation_0630435818381326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_SUM([Calculation_0630435818246156], 0, LAST())'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Precision (Curve)' datatype='real' name='[Calculation_0630435818532879]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0630435818311693] / ([Calculation_0630435818311693] + [Calculation_0630435818381326])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Recall (Curve)' datatype='real' name='[Calculation_0630435818586128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0630435818311693] / WINDOW_SUM([Calculation_0630435818143755], FIRST(), LAST())'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Acquisition Channel' datatype='string' name='[acquisition_channel]' role='dimension' type='nominal' />
            <column caption='Class Pred' datatype='integer' name='[class_pred]' role='measure' type='quantitative' />
            <column caption='Fs Date' datatype='date' name='[fs_date]' role='dimension' type='ordinal' />
