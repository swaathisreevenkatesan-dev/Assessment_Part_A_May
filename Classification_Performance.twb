    <worksheet name='ROC Curve'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Benton Sans Book' fontsize='8'>ROC Curve with 45 Degree diagonal line</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'>The higher this line arches </run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8' italic='true'>above</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'> the 45 degree line, the better the model is at separating Active users from Non Active users</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
